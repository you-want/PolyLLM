{
  "name": "polyllm-monorepo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "PolyLLM · 万剑归宗 — a plugin-based unified LLM access layer.",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm --filter @you-want/polyllm-studio-app... build && pnpm -r run build",
    "build:python": "python3 python/build_packages.py",
    "test": "pnpm -r run test",
    "test:python": "python3 python/run_tests.py",
    "typecheck:python": "python3 -m mypy --config-file python/mypy.ini",
    "verify:python": "python3 python/verify_packages.py",
    "verify:python-install": "python3 python/verify_installed_packages.py",
    "version:python": "python3 python/version.py check",
    "verify:release": "node scripts/verify-release-readiness.mjs",
    "verify:release:frozen": "node scripts/verify-release-readiness.mjs --frozen",
    "verify:integration": "pnpm --filter @you-want/polyllm-integration... build && pnpm --filter @you-want/polyllm-integration test",
    "verify:packed-install": "node scripts/verify-packed-install.mjs",
    "verify:generated-projects": "node scripts/verify-generated-projects.mjs",
    "verify:stability": "pnpm build && pnpm test && pnpm typecheck && pnpm verify:packages && pnpm verify:integration && pnpm verify:generated-projects && pnpm verify:packed-install && pnpm test:python && pnpm typecheck:python && pnpm verify:python && pnpm build:python && python3 -m twine check python/dist/* && pnpm verify:python-install",
    "typecheck": "pnpm -r run typecheck",
    "polyllm": "node packages/cli/dist/main.js",
    "verify:packages": "node scripts/verify-package-metadata.mjs && pnpm --filter @you-want/polyllm-core --filter @you-want/polyllm-openai --filter @you-want/polyllm-deepseek --filter @you-want/polyllm-anthropic --filter @you-want/polyllm-openai-compatible --filter @you-want/polyllm-studio --filter @you-want/polyllm-cli exec publint --strict",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm verify:stability && pnpm verify:release:frozen && changeset publish"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "publint": "^0.3.14"
  }
}
