{
  "description": "Scenario group 4: SSE/NDJSON framing, CRLF, multi-line data, UTF-8 boundary, stream end and mid-stream failure. Each raw body is what the wire parser receives; expectations are the normalized chunk sequence a parser must emit. UTF-8 boundary cases use literal JSON escapes.",
  "schema": "schemas/unified-stream-chunk.json",
  "cases": [
    {
      "id": "sse-lf-split-event",
      "valid": true,
      "wire": "text/event-stream",
      "raw": "data: {\"id\": \"stream-fixture\", \"model\": \"gpt-4o-mini\", \"choices\": [{\"delta\": {\"content\": \"He\"}}]}\n\ndata: {\"id\": \"stream-fixture\", \"model\": \"gpt-4o-mini\", \"choices\": [{\"delta\": {\"content\": \"llo\"}}]}\n\ndata: {\"id\": \"stream-fixture\", \"model\": \"gpt-4o-mini\", \"choices\": [{\"delta\": {}, \"finish_reason\": \"stop\"}]}\n\ndata: [DONE]\n\n",
      "expectedChunks": [
        {
          "delta": {
            "content": "He"
          }
        },
        {
          "delta": {
            "content": "llo"
          }
        },
        {
          "delta": {},
          "finishReason": "stop"
        }
      ]
    },
    {
      "id": "sse-crlf-and-multi-line-data",
      "valid": true,
      "wire": "text/event-stream",
      "raw": "data: {\"id\":\"stream-fixture\",\"model\":\"gpt-4o-mini\",\r\ndata: \"choices\":[{\"delta\":{\"content\":\"ab\"}}]}\r\n\r\n",
      "expectedChunks": [
        {
          "delta": {
            "content": "ab"
          }
        }
      ]
    },
    {
      "id": "ndjson-lines",
      "valid": true,
      "wire": "application/x-ndjson",
      "raw": "{\"id\": \"stream-fixture\", \"model\": \"gpt-4o-mini\", \"choices\": [{\"delta\": {\"content\": \"x\"}}]}\n{\"id\": \"stream-fixture\", \"model\": \"gpt-4o-mini\", \"choices\": [{\"delta\": {\"content\": \"y\"}, \"finish_reason\": \"stop\"}]}\n",
      "expectedChunks": [
        {
          "delta": {
            "content": "x"
          }
        },
        {
          "delta": {
            "content": "y"
          },
          "finishReason": "stop"
        }
      ]
    },
    {
      "id": "utf8-boundary-no-split",
      "valid": true,
      "wire": "text/event-stream",
      "raw": "data: {\"id\": \"stream-fixture\", \"model\": \"gpt-4o-mini\", \"choices\": [{\"delta\": {\"content\": \"☃\"}}]}\n\n",
      "expectedChunks": [
        {
          "delta": {
            "content": "☃"
          }
        }
      ]
    },
    {
      "id": "mid-stream-truncated-json-invalid",
      "valid": false,
      "wire": "text/event-stream",
      "raw": "data: {\"delta_text\":\"abc",
      "expectedChunks": [],
      "error": {
        "category": "parse"
      }
    }
  ]
}
